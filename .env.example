# Bu dosyayı .env adıyla kopyalayın ve değerleri doldurun. .env dosyasını paylaşmayın.

# --- Gizli değerler (zorunlu) ---
# Rastgele değer üretmek için: openssl rand -hex 32
POSTGRES_PASSWORD=
# İşletmeci paneli şifresi, en az 10 karakter.
PANEL_SIFRESI=
# Oturum çerezini imzalar, en az 32 karakter.
OTURUM_ANAHTARI=
# IP adreslerini ve rezervasyon kodlarını özetler, en az 32 karakter.
# Değiştirilirse mevcut rezervasyon kodları geçersiz olur.
IP_OZET_ANAHTARI=

# --- Saha ayarları ---
ACILIS_SAATI=9
KAPANIS_SAATI=24
# Bugün dahil rezervasyona açık gün sayısı.
GUN_SAYISI=7
# Bir IP'nin aynı anda tutabileceği aktif rezervasyon sayısı (rakip katılımları dahil).
IP_SINIRI=3

# --- Ağ ---
# Uygulamanın önündeki ters vekil (Traefik, Caddy, Nginx, Cloudflare...) sayısı.
# Doğrudan erişimde 0. Tek ters vekil arkasında 1. Yanlış değer IP sınırını bozar:
# fazla yazılırsa sınır başlık uydurularak aşılır, eksik yazılırsa herkes tek IP sayılır.
GUVENILIR_VEKIL_SAYISI=0
# Uygulama portunun yayınlanacağı adres. 127.0.0.1 yalnız sunucunun kendisinden (ters vekilden)
# erişim verir. Vekilsiz, doğrudan internete açmak için 0.0.0.0 yazın ve GUVENILIR_VEKIL_SAYISI=0 bırakın.
YAYIN_ADRESI=127.0.0.1
YAYIN_PORTU=3000
